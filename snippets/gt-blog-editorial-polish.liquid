    top: 0;
    left: 0;
    width: 58px;
    height: 2px;
    border-radius: 999px;
    background: var(--gt-blog-gold);
  }

  .gt-blog-article .blog-post-content h3,
  .gt-blog-article .gt-blog-content h3 {
    margin: 1.65em 0 0.55em;
    color: var(--gt-blog-green-dark);
    font-size: clamp(22px, 2.25vw, 30px);
    line-height: 1.16;
    font-weight: 650;
  }

  .gt-blog-article .blog-post-content h4,
  .gt-blog-article .gt-blog-content h4 {
    margin: 1.4em 0 0.45em;
    color: var(--gt-blog-green-dark);
    font-size: 19px;
    line-height: 1.2;
    font-weight: 700;
  }

  .gt-blog-article .blog-post-content :is(h2, h3) + p,
  .gt-blog-article .gt-blog-content :is(h2, h3) + p {
    padding: 18px 20px;
    border: 1px solid rgba(64, 81, 63, 0.13);
    border-left: 3px solid var(--gt-blog-green);
    border-radius: 10px;
    background: linear-gradient(145deg, #fffaf4, #f6eadc);
    box-shadow: 0 16px 42px rgba(66, 48, 34, 0.07);
  }

  .gt-blog-article .blog-post-content :is(ul, ol),
  .gt-blog-article .gt-blog-content :is(ul, ol) {
    display: grid;
    gap: 10px;
    margin: 1.3em 0;
    padding: 20px 22px 20px 42px;
    border: 1px solid rgba(64, 81, 63, 0.12);
    border-radius: 10px;
    background: #fffaf4;
  }

  .gt-blog-article .blog-post-content li::marker,
  .gt-blog-article .gt-blog-content li::marker {
    color: var(--gt-blog-green);
    font-weight: 900;
  }

  .gt-blog-article .blog-post-content blockquote,
  .gt-blog-article .gt-blog-content blockquote {
    margin: 1.8em 0;
    padding: clamp(20px, 3vw, 30px);
    border-left: 4px solid var(--gt-blog-green);
    border-radius: 0 10px 10px 0;
    background: #f6eadc;
    color: var(--gt-blog-ink);
    box-shadow: 0 18px 46px rgba(66, 48, 34, 0.08);
  }

  .gt-blog-article .blog-post-content a,
  .gt-blog-article .gt-blog-content a {
    color: var(--gt-blog-green-dark);
    font-weight: 800;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .gt-blog-article .blog-post-content img,
  .gt-blog-article .gt-blog-content img {
    display: block;
    width: 100%;
    height: auto;
    margin: 2em auto;
    border-radius: 12px;
    box-shadow: 0 20px 54px rgba(66, 48, 34, 0.12);
  }


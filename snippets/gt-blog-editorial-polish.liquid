  }

  .gt-blog-article__cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    width: min(900px, 100%);
    margin: clamp(30px, 4vw, 52px) auto 0;
    padding: clamp(24px, 4vw, 36px);
    border: 1px solid rgba(64, 81, 63, 0.18);
    border-radius: 12px;
    background:
      linear-gradient(135deg, rgba(64, 81, 63, 0.98), rgba(93, 107, 72, 0.94)),

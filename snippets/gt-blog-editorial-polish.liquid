    color: #fffdf8;
    box-shadow: 0 24px 70px rgba(33, 26, 22, 0.16);
  }

  .gt-blog-article__cta span {
    display: block;
    margin-bottom: 8px;
    color: #ead8c2;
    font-size: 12px;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .gt-blog-article__cta h2 {
    margin: 0;
    color: #fffdf8;
    font-size: clamp(24px, 3vw, 36px);
    line-height: 1.1;
    letter-spacing: 0;
  }

  .gt-blog-article__cta p {
    max-width: 560px;
    margin: 10px 0 0;
    color: rgba(255, 253, 248, 0.78);
    line-height: 1.55;
  }

  .gt-blog-article__cta a {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    border-radius: 999px;
    padding: 0 20px;
    background: #fffdf8;
    color: var(--gt-blog-ink);
    font-weight: 900;
    text-decoration: none;
    box-shadow: 0 14px 34px rgba(33, 26, 22, 0.18);
  }

  @media screen and (max-width: 749px) {
    .gt-blog-article__shell {
      width: min(100% - 28px, 1160px);
    }

    .gt-blog-article__header {
      width: 100%;
      padding: 30px 0 12px;
      text-align: center;
    }

    .gt-blog-article__eyebrow {
      display: inline-flex;
      gap: 8px;
      color: var(--gt-blog-clay) !important;
      font-size: 11px;
    }

    .gt-blog-article__eyebrow:before,
    .gt-blog-article__eyebrow:after {
      display: block;
      width: 20px;
    }

    .gt-blog-article__header h1,
    .gt-blog-article__header [id*="blog-post-title"],
    .gt-blog-article__header [id*="blog-post-title"] *,
    .gt-blog-article__header > .text-block:first-of-type,
    .gt-blog-article__header > .text-block:first-of-type * {
      font-size: clamp(30px, 8.4vw, 40px) !important;
      line-height: 1.1 !important;
      font-weight: 560 !important;
      font-style: normal !important;
      text-align: center !important;
    }

    .gt-blog-article__intro {
      max-width: 96%;
      margin-top: 12px;
      font-size: 15px;
      line-height: 1.58;
    }

    .gt-blog-article__media,
    .gt-blog-article__featured-image {
      width: 100%;
      margin-top: 22px;
    }

    .gt-blog-article__media {
      border-radius: 10px;
      padding: 7px;
    }

    .gt-blog-article__image,
    .gt-blog-article .blog-post-featured-image__image {
      aspect-ratio: 4 / 3;
      border-radius: 8px;
      object-fit: cover;
    }

    .gt-blog-article__content-card {
      width: 100%;

﻿{% render 'gt-premium-styles' %}
{% render 'gt-bottom-nav' %}

{% liquid
  assign featured_collection = section.settings.featured_collection
  assign collection_url = routes.all_products_collection_url
  if featured_collection != blank
    assign collection_url = featured_collection.url
  endif

  assign bundle_product = section.settings.bundle_product
  assign bundle_url = collection_url
  if bundle_product != blank
    assign bundle_url = bundle_product.url
  endif

  assign comparison_eyebrow = section.settings.comparison_eyebrow | default: 'INGREDIENT TRANSPARENCY'
  assign comparison_heading = section.settings.comparison_heading | default: 'Before you buy a viral soap, check the label.'
  assign comparison_text = section.settings.comparison_text | default: 'Viral bars can look convincing online, but the label often tells the real story. Glow Terra is built around clear ingredient choices, botanical oils, and formulas designed to feel intentional from the first lather.'
  assign comparison_primary_label = section.settings.comparison_primary_label | default: 'Shop Glow Terra'
  assign comparison_primary_link = section.settings.comparison_primary_link | default: collection_url
%}

<section class="gt-store gt-home" aria-label="Glow Terra homepage">
  {% if section.settings.summer_sale_enabled %}
    <section class="gt-summer-sale" aria-label="Glow Terra summer clearance event">
      <div class="gt-wrap gt-summer-sale__inner">
        <div class="gt-summer-sale__copy">
          <p class="gt-summer-sale__eyebrow">{{ section.settings.summer_sale_eyebrow }}</p>
          <p>{{ section.settings.summer_sale_text }}</p>
        </div>

        <div class="gt-summer-sale__deals" aria-label="Summer clearance prices">
          <span><strong>$4.99</strong></span>
          <span><strong>$11.99</strong></span>
        </div>

        <div
          class="gt-summer-sale__countdown"
          data-gt-summer-sale-countdown
          data-end="{{ section.settings.summer_sale_end_date | escape }}"
          aria-label="Summer clearance countdown"
        >
          <span>
            <strong data-gt-summer-days>00</strong>
            <small>Days</small>
          </span>
          <span>
            <strong data-gt-summer-hours>00</strong>
            <small>Hours</small>
          </span>
          <span>
            <strong data-gt-summer-minutes>00</strong>
            <small>Minutes</small>
          </span>
          <span>
            <strong data-gt-summer-seconds>00</strong>
            <small>Seconds</small>
          </span>
        </div>
      </div>
    </section>
  {% endif %}

  <div class="gt-home-hero">
    {% if section.settings.hero_image != blank %}
      {{ section.settings.hero_image | image_url: width: 2200 | image_tag: class: 'gt-home-hero__bg', loading: 'eager', alt: section.settings.hero_image.alt }}
    {% else %}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'gt-home-hero__bg' }}
    {% endif %}
    <div class="gt-home-hero__inner gt-wrap">
      <div class="gt-home-hero__copy">
        <p class="gt-eyebrow">{{ section.settings.hero_eyebrow }}</p>
        <h1 class="gt-title">{{ section.settings.hero_heading }}</h1>
        <p>{{ section.settings.hero_text }}</p>
        <div class="gt-home-hero__actions">
          <a class="gt-btn gt-btn--dark" href="{{ collection_url }}">Shop Collection</a>
          <a class="gt-btn gt-btn--light" href="{{ bundle_url }}">Bundle &amp; Save</a>
        </div>
        <div class="gt-home-hero__pills">
          <span>Fragrance-free focus</span>
          <span>Plant oil base</span>
          <span>Small batch crafted</span>
        </div>
      </div>
      <aside class="gt-home-hero__feature" aria-label="Glow Terra product preview">
        {% if section.settings.hero_side_image != blank %}
          {{ section.settings.hero_side_image | image_url: width: 900 | image_tag: loading: 'eager', alt: section.settings.hero_side_image.alt }}
        {% elsif bundle_product.featured_image != blank %}
          {{ bundle_product.featured_image | image_url: width: 900 | image_tag: loading: 'eager', alt: bundle_product.title }}
        {% else %}
          {{ 'product-1' | placeholder_svg_tag }}
        {% endif %}
        <div>
          <strong>Multi-oil formulas</strong>
          <span>Crafted with botanical oils, butters, and skin-first ingredients.</span>
        </div>
      </aside>
    </div>
  </div>

  <div class="gt-home-trust">
    <span>100% Natural Ingredients</span>
    <span>Secure Checkout</span>
    <span>Fast U.S. Shipping</span>
    <span>Small Batch Crafted</span>
  </div>

  <section class="gt-section gt-wrap">
    <div class="gt-heading">
      <div>
        <p class="gt-eyebrow">Shop the routine</p>
        <h2 class="gt-title">Purposeful bars for skin, scalp, and glow.</h2>
      </div>
      <a class="gt-heading__link" href="{{ collection_url }}">View all products</a>
    </div>
    <div class="gt-home-products">
      {% assign rendered_products = 0 %}
      {% for block in section.blocks %}
        {% if block.type == 'featured_product' and block.settings.product != blank %}
          {% render 'gt-product-card', product: block.settings.product, show_quick_add: true %}
          {% assign rendered_products = rendered_products | plus: 1 %}
        {% endif %}
      {% endfor %}
      {% if rendered_products == 0 %}
        {% liquid
          assign fallback_collection = featured_collection
          if fallback_collection == blank
            assign fallback_collection = collections.all
          endif
        %}
        {% for product in fallback_collection.products limit: 4 %}
          {% render 'gt-product-card', product: product, show_quick_add: true %}
        {% endfor %}
      {% endif %}
    </div>
  </section>

  <section class="gt-section gt-wrap gt-home-why">
    <div>
      <p class="gt-eyebrow">Why Glow Terra</p>
      <h2 class="gt-title">Skincare-first soap, built around ingredient density.</h2>
      <p class="gt-copy">Each bar is designed around botanical oils and butters, so the cleansing experience feels intentional, gentle, and elevated.</p>
    </div>
    <div class="gt-home-why__grid">
      <article class="gt-card"><span>01</span><h3>Multi-oil formulations</h3><p>Coconut, olive, castor, shea, jojoba, and targeted botanicals work together.</p></article>
      <article class="gt-card"><span>02</span><h3>Ingredient density</h3><p>The formula keeps the focus on oils, butters, and plant-based actives.</p></article>
      <article class="gt-card"><span>03</span><h3>Fragrance-free focus</h3><p>No artificial fragrance. Just a more comfortable bar for function-first routines.</p></article>
      <article class="gt-card"><span>04</span><h3>Skincare-first philosophy</h3><p>Refined bars created to support daily routines with a clean, trustworthy feel.</p></article>
    </div>
  </section>

  <section class="gt-section gt-wrap gt-home-center">
    <p class="gt-eyebrow">Customer feedback</p>
    <h2 class="gt-title">Quiet results customers come back to.</h2>
    <div class="gt-home-reviews">
      {% assign rendered_reviews = 0 %}
      {% for block in section.blocks %}
        {% if block.type == 'review' %}
          {% assign rendered_reviews = rendered_reviews | plus: 1 %}
          <article class="gt-card gt-home-review" {{ block.shopify_attributes }}>
            {% if block.settings.avatar != blank %}
              {{ block.settings.avatar | image_url: width: 160 | image_tag: class: 'gt-home-review__avatar', loading: 'lazy', alt: block.settings.name }}
            {% else %}
              <div class="gt-home-review__avatar" aria-hidden="true"><span>{{ block.settings.name | slice: 0 }}</span></div>
            {% endif %}
            <div>
              <span class="gt-rating" aria-label="Customer rating">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
              <p>"{{ block.settings.quote }}"</p>
              <strong>{{ block.settings.name }}</strong>
            </div>
          </article>
        {% endif %}
      {% endfor %}
      {% if rendered_reviews == 0 %}
        <article class="gt-card gt-home-review">
          <img class="gt-home-review__avatar" src="https://images.unsplash.com/photo-1494790108377-be9c29b29330?auto=format&fit=crop&w=160&h=160&q=80" loading="lazy" alt="Customer portrait">
          <div>
            <span class="gt-rating" aria-label="Customer rating">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
            <p>"The Turmeric Bar feels clean and gentle on my skin."</p>
            <strong>Maya R.</strong>
          </div>
        </article>
        <article class="gt-card gt-home-review">
          <img class="gt-home-review__avatar" src="https://images.unsplash.com/photo-1500648767791-00dcc994a43e?auto=format&fit=crop&w=160&h=160&q=80" loading="lazy" alt="Customer portrait">
          <div>
            <span class="gt-rating" aria-label="Customer rating">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
            <p>"The Batana bar has become part of my weekly routine."</p>
            <strong>Jordan L.</strong>
          </div>
        </article>
        <article class="gt-card gt-home-review">
          <img class="gt-home-review__avatar" src="https://images.unsplash.com/photo-1438761681033-6461ffad8d80?auto=format&fit=crop&w=160&h=160&q=80" loading="lazy" alt="Customer portrait">
          <div>
            <span class="gt-rating" aria-label="Customer rating">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
            <p>"Simple ingredients, nice lather, and my skin does not feel tight after."</p>
            <strong>Alina P.</strong>
          </div>
        </article>
      {% endif %}
    </div>
  </section>

  {% comment %}
    ORIGINAL INGREDIENT LIBRARY SECTION PRESERVED FOR RESTORE:
    <section class="gt-section gt-wrap">
      <div class="gt-heading">
        <div>
          <p class="gt-eyebrow">Ingredient library</p>
          <h2 class="gt-title">Botanicals chosen for a clean, comfortable routine.</h2>
        </div>
      </div>
      <div class="gt-home-ingredients">
        {% for block in section.blocks %}
          {% if block.type == 'ingredient' %}
            <article {{ block.shopify_attributes }}>
              {% if block.settings.image != blank %}
                {{ block.settings.image | image_url: width: 700 | image_tag: loading: 'lazy', alt: block.settings.title }}
              {% else %}
                {{ 'collection-1' | placeholder_svg_tag }}
              {% endif %}
              {% assign polished_ingredient_titles = 'Turmeric|Batana Oil|Carrot Extract|Shea Butter|Jojoba Oil' | split: '|' %}
              <h3{% if polished_ingredient_titles contains block.settings.title %} class="gt-home-ingredient-title--polished"{% endif %}>{{ block.settings.title }}</h3>
              <p>{{ block.settings.text }}</p>
            </article>
          {% endif %}
        {% endfor %}
      </div>
    </section>
  {% endcomment %}

  <section class="gt-section gt-wrap gt-ingredient-comparison" aria-label="Glow Terra ingredient transparency comparison">
    <div class="gt-ingredient-comparison__intro">
      <p class="gt-eyebrow">{{ comparison_eyebrow }}</p>
      <h2 class="gt-title">{{ comparison_heading }}</h2>
      <p class="gt-copy">{{ comparison_text }}</p>

      <div class="gt-ingredient-comparison__actions">
        {% if comparison_primary_label != blank %}
          <a class="gt-btn gt-btn--dark" href="{{ comparison_primary_link }}">{{ comparison_primary_label }}</a>
        {% endif %}
      </div>
    </div>

    <div class="gt-ingredient-comparison__grid">
      <article class="gt-ingredient-comparison__card">
        <div class="gt-ingredient-comparison__image">
          {% if section.settings.comparison_left_image != blank %}
            <picture>
              {% if section.settings.comparison_left_mobile_image != blank %}
                <source media="(max-width: 680px)" srcset="{{ section.settings.comparison_left_mobile_image | image_url: width: 900 }}">
              {% endif %}
              {{
                section.settings.comparison_left_image
                | image_url: width: 2400
                | image_tag:
                  loading: 'lazy',
                  widths: '900, 1200, 1600, 2000, 2400',
                  sizes: '(min-width: 990px) 700px, 100vw',
                  alt: section.settings.comparison_left_image.alt
              }}
            </picture>
          {% else %}
            {{ 'collection-1' | placeholder_svg_tag }}
          {% endif %}
        </div>
        <div class="gt-ingredient-comparison__caption">
          <h3>{{ section.settings.comparison_left_title }}</h3>
          <p>{{ section.settings.comparison_left_text }}</p>
        </div>
      </article>

      <article class="gt-ingredient-comparison__card gt-ingredient-comparison__card--glow">
        <div class="gt-ingredient-comparison__image">
          {% if section.settings.comparison_right_image != blank %}
            <picture>
              {% if section.settings.comparison_right_mobile_image != blank %}
                <source media="(max-width: 680px)" srcset="{{ section.settings.comparison_right_mobile_image | image_url: width: 900 }}">
              {% endif %}
              {{
                section.settings.comparison_right_image
                | image_url: width: 2400
                | image_tag:
                  loading: 'lazy',
                  widths: '900, 1200, 1600, 2000, 2400',
                  sizes: '(min-width: 990px) 700px, 100vw',
                  alt: section.settings.comparison_right_image.alt
              }}
            </picture>
          {% else %}
            {{ 'collection-2' | placeholder_svg_tag }}
          {% endif %}
        </div>
        <div class="gt-ingredient-comparison__caption">
          <h3>{{ section.settings.comparison_right_title }}</h3>
          <p>{{ section.settings.comparison_right_text }}</p>
        </div>
      </article>
    </div>

    <div class="gt-ingredient-comparison__trust" aria-label="Glow Terra ingredient trust points">
      {% if section.settings.comparison_trust_1 != blank %}<span>{{ section.settings.comparison_trust_1 }}</span>{% endif %}
      {% if section.settings.comparison_trust_2 != blank %}<span>{{ section.settings.comparison_trust_2 }}</span>{% endif %}
      {% if section.settings.comparison_trust_3 != blank %}<span>{{ section.settings.comparison_trust_3 }}</span>{% endif %}
      {% if section.settings.comparison_trust_4 != blank %}<span>{{ section.settings.comparison_trust_4 }}</span>{% endif %}
    </div>
  </section>

  <section class="gt-home-sale gt-wrap">
    {% if section.settings.banner_image != blank %}
      {{ section.settings.banner_image | image_url: width: 1800 | image_tag: class: 'gt-home-sale__bg', loading: 'lazy', alt: section.settings.banner_image.alt }}
    {% endif %}
    <div>
      <p class="gt-eyebrow">Limited bundle value</p>
      <h2 class="gt-title">Real Ingredients. Real Results.</h2>
      <p>Build a complete routine with the 3-Bar Bundle for <strong>$19.99</strong>.</p>
    </div>
    <a class="gt-btn gt-btn--dark" href="{{ bundle_url }}">Shop 3-Bar Bundle</a>
  </section>

  <section class="gt-section gt-wrap gt-home-center">
    <p class="gt-eyebrow">Glow Terra Routine Guide</p>
    <h2 class="gt-title">Simple ways to use each bar with confidence.</h2>
    <div class="gt-home-social">
      {% for block in section.blocks %}
        {% if block.type == 'social_image' %}
          <article class="gt-routine-card" {{ block.shopify_attributes }}>
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 700 | image_tag: loading: 'lazy', alt: block.settings.alt }}
            {% else %}
              {{ 'lifestyle-2' | placeholder_svg_tag }}
            {% endif %}
            <div>
              <h3>{{ block.settings.title }}</h3>
              <p>{{ block.settings.text }}</p>
            </div>
          </article>
        {% endif %}
      {% endfor %}
    </div>
  </section>

  <section class="gt-home-newsletter">
    <div class="gt-wrap gt-home-newsletter__inner">
      <div>
        <p class="gt-eyebrow">Glow notes</p>
        <h2 class="gt-title">Join The Glow Terra Community</h2>
        <p class="gt-copy">Get early access to restocks, bundles, and ingredient education.</p>
      </div>
      <div>
        {% form 'customer', class: 'gt-home-newsletter__form' %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <label class="visually-hidden" for="gt-newsletter-email">Email address</label>
          <input class="gt-field" id="gt-newsletter-email" type="email" name="contact[email]" placeholder="Email address" required>
          <button class="gt-btn gt-btn--dark" type="submit">Sign Up</button>
        {% endform %}
        <div class="gt-home-newsletter__trust">
          <span>No spam</span>
          <span>Restock alerts</span>
          <span>Bundle updates</span>
        </div>
      </div>
    </div>
  </section>
</section>

<style>
  .gt-store.gt-home{margin-top:-20px}
  .gt-summer-sale{position:relative;z-index:2;overflow:hidden;background:linear-gradient(135deg,#344b3a 0%,#40513f 58%,#4f6044 100%);color:#fffdf8;border-bottom:1px solid rgba(255,253,248,.14);box-shadow:0 8px 22px rgba(33,26,22,.11)}
  .gt-summer-sale__inner{position:relative;z-index:1;display:flex;align-items:center;justify-content:center;gap:6px 10px;min-height:38px;padding:4px 0;text-align:center;flex-wrap:wrap}
  .gt-summer-sale__copy{display:flex;align-items:center;justify-content:center;gap:8px;min-width:0;flex-wrap:wrap}
  .gt-summer-sale__copy p:not(.gt-summer-sale__eyebrow){margin:0;color:rgba(255,253,248,.82);font-size:10.5px;line-height:1.2;white-space:nowrap}
  .gt-summer-sale__eyebrow{margin:0;color:#ead8c2;font-size:10.5px;font-weight:900;letter-spacing:.13em;text-transform:uppercase;white-space:nowrap;text-align:center}
  .gt-summer-sale__deals,.gt-summer-sale__countdown{display:flex;align-items:center;justify-content:center;gap:4px;flex-wrap:wrap}
  .gt-summer-sale__deals span,.gt-summer-sale__countdown span{display:grid;place-items:center;min-width:54px;min-height:30px;padding:3px 7px;border:1px solid rgba(255,253,248,.15);border-radius:7px;background:rgba(255,250,244,.09);box-shadow:inset 0 1px 0 rgba(255,255,255,.1)}
  .gt-summer-sale__deals strong,.gt-summer-sale__countdown strong{display:block;color:#fffdf8;font-size:13px;line-height:1;font-weight:900}
  .gt-summer-sale__deals small,.gt-summer-sale__countdown small{display:block;margin-top:2px;color:rgba(255,253,248,.7);font-size:7px;font-weight:900;letter-spacing:.04em;text-align:center;text-transform:uppercase}

  @media(min-width:990px){
    .gt-summer-sale__countdown{align-self:center;transform:translateY(-1px)}
  }

  @media(max-width:990px){
    .gt-summer-sale{background:linear-gradient(135deg,#344b3a 0%,#40513f 58%,#4f6044 100%)}

    .gt-summer-sale__inner{
      gap:4px 6px;
      min-height:0;
      padding:5px 0;
    }

    .gt-summer-sale__copy{
      width:100%;
      gap:2px 6px;
    }

    .gt-summer-sale__copy p:not(.gt-summer-sale__eyebrow){
      font-size:9.5px;
      line-height:1.15;
      white-space:normal;
      flex-basis:100%;
    }

    .gt-summer-sale__deals span,
    .gt-summer-sale__countdown span{
      min-width:46px;
      min-height:25px;
      padding:2px 4px;
    }
  }

  @media(max-width:680px){
    .gt-summer-sale__inner{
      padding:4px 0 5px;
      gap:3px;
    }

    .gt-summer-sale__eyebrow{
      width:100%;
      font-size:8.8px;
      line-height:1.05;
      letter-spacing:.1em;
    }

    .gt-summer-sale__copy p:not(.gt-summer-sale__eyebrow){
      font-size:8.4px;
      line-height:1.1;
    }

    .gt-summer-sale__deals,
    .gt-summer-sale__countdown{
      gap:3px;
    }

    .gt-summer-sale__deals span,
    .gt-summer-sale__countdown span{
      min-width:41px;
      min-height:23px;
      padding:2px 3px;
      border-radius:6px;
    }

    .gt-summer-sale__deals strong,
    .gt-summer-sale__countdown strong{
      font-size:10.5px;
    }

    .gt-summer-sale__deals small,
    .gt-summer-sale__countdown small{
      font-size:5.8px;
      margin-top:1px;
    }
  }

  .gt-home-hero{position:relative;min-height:760px;display:grid;align-items:center;background:#1f1a16;color:#fff;overflow:hidden}
  .gt-home-hero__bg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;filter:saturate(.86) contrast(.96)}
  .gt-home-hero:after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(30,22,17,.84),rgba(45,35,28,.58) 46%,rgba(246,230,211,.16)),linear-gradient(0deg,rgba(20,15,12,.45),rgba(20,15,12,.08))}
  .gt-home-hero__inner{position:relative;z-index:1;display:grid;grid-template-columns:minmax(0,1fr) 430px;gap:56px;align-items:center;padding:96px 0 74px}
  .gt-home-hero h1{font-size:clamp(46px,6vw,78px);max-width:850px;color:#fff}
  .gt-home-hero__copy>p:not(.gt-eyebrow){max-width:560px;margin:22px 0 0;font-size:20px;line-height:1.55;color:rgba(255,255,255,.86)}
  .gt-home-hero__actions,.gt-home-hero__pills{display:flex;gap:12px;flex-wrap:wrap;margin-top:34px}
  .gt-home-hero__pills{margin-top:28px;gap:10px}
  .gt-home-hero__pills span{border:1px solid rgba(255,255,255,.26);border-radius:999px;padding:8px 12px;font-size:13px;color:rgba(255,255,255,.86)}
  .gt-home-hero__feature{position:relative;border:1px solid rgba(255,255,255,.28);background:rgba(255,250,244,.12);backdrop-filter:blur(14px);padding:14px;border-radius:8px;box-shadow:0 30px 80px rgba(0,0,0,.24)}
  .gt-home-hero__feature img,.gt-home-hero__feature svg{width:100%;aspect-ratio:4/5;object-fit:cover;border-radius:6px}
  .gt-home-hero__feature div{position:absolute;left:-28px;bottom:34px;width:250px;background:#fffaf4;color:var(--gt-ink);border:1px solid rgba(36,29,24,.08);border-radius:8px;padding:16px;box-shadow:0 24px 60px rgba(36,29,24,.18)}
  .gt-home-hero__feature strong{display:block;margin-bottom:5px}.gt-home-hero__feature span{font-size:13px;color:var(--gt-muted);line-height:1.5}
  .gt-home-trust{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--gt-line);border-block:1px solid var(--gt-line)}
  .gt-home-trust span{display:flex;align-items:center;justify-content:center;background:var(--gt-card);padding:18px 12px;font-size:14px;font-weight:700;text-align:center}
  .gt-home-products{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}
  .gt-home-why{display:grid;grid-template-columns:.9fr 1.35fr;gap:44px;align-items:start}
  .gt-home-why__grid,.gt-home-reviews{display:grid;grid-template-columns:repeat(2,1fr);gap:16px}
  .gt-home-why article,.gt-home-reviews article{padding:24px}.gt-home-why span{color:var(--gt-clay);font-weight:800}
  .gt-home-center{text-align:center}.gt-home-center .gt-title{margin-inline:auto}
  .gt-home-reviews{grid-template-columns:repeat(3,1fr);margin-top:34px;text-align:left}
  .gt-home-review{position:relative;display:grid;grid-template-columns:66px 1fr;gap:18px;align-items:center;background:#fff;border-color:rgba(70,81,59,.12);box-shadow:0 26px 72px rgba(63,76,54,.13)}
  .gt-home-review:before{content:"";position:absolute;inset:0;border-radius:8px;background:linear-gradient(135deg,rgba(255,255,255,.62),rgba(64,81,63,.03));pointer-events:none}
  .gt-home-review>*{position:relative}
